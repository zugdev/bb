{
  "name": "bb-plugin-parent-link",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shows a link to a child thread's parent, or a fork's source, before the title in the thread header.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.88"
  },
  "bb": {
    "name": "Parent link",
    "description": "Shows a link to a child thread's parent, or a fork's source, before the title in the thread header.",
    "branding": {
      "icon": "ChevronLeft"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
